// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["driverAdapters"]
}

datasource db {
    provider     = "sqlite"
    url          = "file:./dev.db" //env("TURSO_DATABASE_URL")
    relationMode = "prisma"
}

model Example {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Job {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    title       String
    description String?
    ui_data     String
    data        String

    customFunctions CustomFunction[]
    variables       Variables[]

    jobGroups JobGroup[]

    authorId String
}

model JobGroup {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    name        String
    description String?

    jobs Job[]

    authorId String
    shared   Shared[]
}

model Shared {
    id        String   @id
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    userId String

    jobGroups JobGroup[]

    role String
}

model Variables {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name        String
    description String?
    type        String
    typeId      String  @default("")
    required    Boolean @default(false)
    default     String?
    value       String?

    jobId String

    job Job[]

    authorId String
}

model CustomFunction {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name        String
    description String?
    parameters  Parameters[]

    jobId String

    job Job[]

    authorId String
}

model Parameters {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name        String
    description String?
    type        String
    required    Boolean @default(false)
    default     String?
    io          String

    customFunctionId String

    customFunction CustomFunction @relation(fields: [customFunctionId], references: [id])

    @@index([customFunctionId], name: "customFunctionId")
}

model Pins {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    pinCode String
    userId  String
    status  String

    deviceId          String
    deviceName        String
    deviceDescription String
    deviceType        String
}

model InstructionSetSchemaVersion {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name        String
    description String

    data String

    jobid String

    productionBuild Boolean @default(false)

    authorId String
}

model APISchema {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name        String
    description String

    uri     String
    method  String
    headers String
    body    String

    schemaResult String

    authorId String
}

model VariableType {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    typeName    String
    description String
    colorHex    String @default("#000000")
    jobId       String

    authorId String

    @@index([authorId], name: "authorId")
}
